    "@mantine/hooks": "^9.1.1",
    "@mantine/modals": "^9.1.1",
    "@mantine/notifications": "^9.1.1",
    "@react-router/node": "7.15.1",
    "@react-router/serve": "7.15.1",
    "@tanstack/react-query": "^5.100.8",
    "axios": "^1.13.3",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "isbot": "^5",
    "lucide-react": "^1.21.0",
    "mantine-form-zod-resolver": "^1.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "7.15.1",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
