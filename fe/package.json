{
  "name": "bosun-fe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.8.0"
    }
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "react-router typegen && tsc",
