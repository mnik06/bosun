# Bosun backend REST API (the data source)
VITE_API_URL=http://127.0.0.1:1506

# Supabase Auth. Both values are public — the publishable key is meant to ship in
# the browser bundle, and is the same pair the backend resolves tokens against.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
