# Bosun backend REST API (the data source)
VITE_API_URL=http://127.0.0.1:1506

# Supabase Auth. Both values are public — the publishable key is meant to ship in
# the browser bundle, and is the same pair the backend resolves tokens against.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The public half of the backend's VAPID_PUBLIC_KEY (be/.env) — the same key
# pair on both sides is what lets a browser's push subscription validate
# against this server's signature.
VITE_VAPID_PUBLIC_KEY=...
