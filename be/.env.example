NODE_ENV=local
HOST=127.0.0.1
PORT=1506

# Postgres connection string used by the server and by drizzle-kit.
# Supabase: use the session pooler on port 5432 — the transaction pooler (6543)
# breaks drizzle-kit migrate, and the direct host is IPv6-only without the IPv4 add-on.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/bosun

# Public origin this server is reachable at. Printed into the enroll command the
# agent is given, and used by the agent to derive its WebSocket URL.
PUBLIC_SERVER_URL=http://127.0.0.1:1506

# Public origin the web app is served from. Only used to link a pull request back
# to the plan that produced it, so it has to be the URL a reviewer can open.
PUBLIC_APP_URL=http://127.0.0.1:5173

# Where install.sh downloads the agent binaries and SHA256SUMS from.
# GitHub's /releases/latest/download/ always resolves to the newest published release.
AGENT_LATEST_RELEASE_URL=https://github.com/mnik06/bosun/releases/latest
AGENT_DOWNLOAD_BASE_URL=https://github.com/mnik06/bosun/releases/download/agent-v{version}

# Supabase Auth. Both values are public: the publishable key ships in the browser
# bundle too. The backend uses them for auth.getUser only — never for data, and
# never the secret key, which would grant it authority over the whole auth schema.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Creates member accounts. Blanket authority over the auth schema — a Fly secret,
# never a fly.toml [env] entry.
SUPABASE_SECRET_KEY=sb_secret_...
