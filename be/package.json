{
  "name": "bosun-be",
  "version": "1.0.0",
  "private": true,
  "description": "Bosun backend — Fastify REST API that drives AI coding agents on a remote VPS",
  "main": "index.js",
  "scripts": {
    "local": "nodemon -r tsconfig-paths/register src/api/api.ts",
    "build": "rm -R -f dist && tsc -p tsconfig.build.json",
    "production": "TS_NODE_BASEURL=dist node -r tsconfig-paths/register dist/src/api/api.js",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "preflight": "pnpm typecheck && pnpm lint:fix && pnpm test && pnpm dup",
    "db:migration:run": "drizzle-kit migrate",
    "db:migration:generate": "drizzle-kit generate",
    "db:migration:studio": "drizzle-kit studio",
    "dup": "jscpd src",
    "dup:report": "jscpd src --reporters console-full"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@fastify/websocket": "^11.3.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^6.1.0",
    "nanoid": "^3.3.18",
    "postgres": "^3.4.9",
    "tsconfig-paths": "^4.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.6.0",
    "jscpd": "^5.0.16",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.15"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.8.0"
    }
  },
  "packageManager": "pnpm@11.8.0"
}
